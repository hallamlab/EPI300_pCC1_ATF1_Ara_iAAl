# ============================================================
# Volcano plot: EPI300_pCC1_ATF1 (Ara vs noAra)
# Styled to match Met_EPPCC1_EPFOS_iAA_Volcano.png
# ============================================================

library(tidyverse)   # dplyr, ggplot2, readr
library(ggrepel)     # non-overlapping labels with leader lines

# ---- 1. Load data -------------------------------------------------
# Expects a CSV with columns: Compound, EPI300_pCC1_ATF1_noAra, EPI300_pCC1_ATF1_Ara
df <- read_csv("EPI300_pCC1_ATF1_noAraAraCla.csv", show_col_types = FALSE) %>%
  filter(Compound != "0", !is.na(EPI300_pCC1_ATF1_noAra), !is.na(EPI300_pCC1_ATF1_Ara))

# ---- 2. Fold change -------------------------------------------------
total_noAra <- sum(df$EPI300_pCC1_ATF1_noAra)
total_Ara   <- sum(df$EPI300_pCC1_ATF1_Ara)

df <- df %>%
  mutate(
    prop_noAra = EPI300_pCC1_ATF1_noAra / total_noAra,
    prop_Ara   = EPI300_pCC1_ATF1_Ara   / total_Ara,
    log2FC     = log2(prop_Ara / prop_noAra)
  )

# ---- 3. Significance ------------------------------------------------
# NOTE: this dataset has ONE measurement per compound per condition (no
# biological replicates), so a textbook p-value isn't really available.
# As a stand-in, this uses a two-proportion z-test of each compound's
# share of the total signal in Ara vs noAra. Treat these p-values as a
# rough, exploratory ranking, NOT true biological significance — with
# replicate data, swap this block out for a proper t-test/limma/DESeq2 call.
df <- df %>%
  rowwise() %>%
  mutate(
    p_pool = (EPI300_pCC1_ATF1_noAra + EPI300_pCC1_ATF1_Ara) / (total_noAra + total_Ara),
    se     = sqrt(p_pool * (1 - p_pool) * (1/total_noAra + 1/total_Ara)),
    z      = (prop_Ara - prop_noAra) / se,
    pvalue = 2 * pnorm(-abs(z)),
    neglog10p = -log10(pvalue)
  ) %>%
  ungroup()

# ---- 4. Flag significant hits ---------------------------------------
fc_cutoff <- 1     # |log2FC| threshold (matches dotted vertical lines)
p_cutoff  <- 2     # -log10(p) threshold (matches dotted horizontal line)

df <- df %>%
  mutate(
    significant = abs(log2FC) > fc_cutoff & neglog10p > p_cutoff,
    label = ifelse(significant, Compound, NA)
  )

# Optional: only label the top N hits by significance, to avoid clutter
top_labels <- df %>%
  filter(significant) %>%
  slice_max(neglog10p, n = 10) %>%
  pull(Compound)

df <- df %>% mutate(label = ifelse(Compound %in% top_labels, Compound, NA))

# ---- 5. Plot ----------------------------------------------------------
p <- ggplot(df, aes(x = log2FC, y = neglog10p)) +
  geom_point(aes(color = significant), size = 2, show.legend = FALSE) +
  scale_color_manual(values = c(`TRUE` = "red", `FALSE` = "grey70")) +
  geom_vline(xintercept = c(-fc_cutoff, fc_cutoff), linetype = "dotted") +
  geom_hline(yintercept = p_cutoff, linetype = "dotted") +
  geom_text_repel(
    aes(label = label),
    size = 3.5,
    max.overlaps = Inf,
    segment.color = "black",
    box.padding = 0.4,
    min.segment.length = 0
  ) +
  labs(
    title = "EPI300 pCC1-ATF1 Metabolome Response\n(Ara vs noAra)",
    x = expression(log[2]~fold~change),
    y = expression(-log[10]~p~value)
  ) +
  theme_bw(base_size = 14) +
  theme(
    plot.title = element_text(hjust = 0.5, size = 16),
    panel.grid.minor = element_blank(),
    axis.title = element_text(size = 14)
  )

print(p)

ggsave("EPI300_ATF1_volcano.png", p, width = 10, height = 8, dpi = 300)
