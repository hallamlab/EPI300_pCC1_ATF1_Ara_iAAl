## Volcano-style plot for Ctrl_Sample.csv
## Control (noAra) vs Sample (+Ara_iAAl) — compound peak areas
## Values are AVERAGES of 3 replicates (individual replicate values not available)
##
## IMPORTANT CAVEAT (please read):
## Because only averaged values are available (no per-replicate data), a real
## p-value cannot be computed. As agreed, the y-axis is -log10(total peak area),
## used purely as a SIGNAL-STRENGTH proxy, NOT a statistical significance value.
## Points near the TOP of the plot have SMALLER total peak areas (weaker signal);
## points near the BOTTOM have the largest, most robustly detected peaks.
## Treat this as an exploratory plot, not a statistically validated one.

infile  <- "/mnt/user-data/uploads/Ctrl_Sample.csv"
outfile <- "/mnt/user-data/outputs/volcano_plot_v2.png"

## ---- 1. Read data, skipping metadata row 2 ----
raw <- read.csv(infile, header = TRUE, skip = 1, stringsAsFactors = FALSE,
                 col.names = c("name", "area_ctrl", "area_samp"),
                 fileEncoding = "UTF-8-BOM")

raw$area_ctrl <- suppressWarnings(as.numeric(raw$area_ctrl))
raw$area_samp <- suppressWarnings(as.numeric(raw$area_samp))

## Drop rows with no compound name or non-numeric/missing areas
keep <- !is.na(raw$name) & trimws(raw$name) != "" & raw$name != "0" &
        !is.na(raw$area_ctrl) & !is.na(raw$area_samp)
dat <- raw[keep, ]
dat$name <- trimws(dat$name)

## Aggregate any duplicate compound names (sum peak areas)
dat <- aggregate(cbind(area_ctrl, area_samp) ~ name, data = dat, FUN = sum)

cat(sprintf("Total compounds: %d\n", nrow(dat)))
cat(sprintf("Only in control (sample area = 0): %d\n", sum(dat$area_samp == 0)))
cat(sprintf("Only in sample (control area = 0): %d\n", sum(dat$area_ctrl == 0)))
cat(sprintf("Detected in both: %d\n", sum(dat$area_ctrl > 0 & dat$area_samp > 0)))

## ---- 2. Fold change (log2), pseudocount for zero handling ----
pseudo <- 1
dat$log2FC <- log2((dat$area_samp + pseudo) / (dat$area_ctrl + pseudo))

## ---- 3. Signal-strength proxy for y-axis ----
dat$total_area <- dat$area_ctrl + dat$area_samp
dat$y <- -log10(dat$total_area)

## ---- 4. Classify points ----
fc_thresh <- 1  # |log2FC| > 1 -> 2-fold change
dat$status <- "Unchanged"
dat$status[dat$log2FC >  fc_thresh] <- "Up in Sample (+Ara)"
dat$status[dat$log2FC < -fc_thresh] <- "Up in Control"
dat$status[dat$area_ctrl == 0] <- "Sample-only"
dat$status[dat$area_samp == 0] <- "Control-only"

col_map <- c("Unchanged" = "grey70",
             "Up in Sample (+Ara)" = "firebrick",
             "Up in Control" = "steelblue",
             "Sample-only" = "darkorange",
             "Control-only" = "darkorchid")
dat$col <- col_map[dat$status]

## ---- 5. Label ALL compounds beyond the fold-change threshold ----
lbl <- dat[dat$status %in% c("Up in Control", "Up in Sample (+Ara)"), ]
lbl <- lbl[order(lbl$log2FC), ]
cat(sprintf("Labeling %d compounds with |log2FC| > %g\n", nrow(lbl), fc_thresh))

## ---- 6. Plot ----
dir.create(dirname(outfile), showWarnings = FALSE, recursive = TRUE)
png(outfile, width = 3000, height = 2200, res = 230)

par(mar = c(5, 5, 4, 2))

xr <- max(abs(dat$log2FC), na.rm = TRUE) + 1

plot(dat$log2FC, dat$y,
     pch = 21, bg = adjustcolor(dat$col, alpha.f = 0.8), col = "grey30", cex = 0.8,
     xlab = expression(log[2]~"Fold Change (Sample / Control)"),
     ylab = expression(-log[10]~"(Total Peak Area)  [signal-strength proxy]"),
     main = "EPI300_pCC1_ATF1: Control vs +Ara_iAAl (avg of 3 replicates)",
     xlim = c(-xr, xr))

abline(v = c(-fc_thresh, fc_thresh), lty = 2, col = "grey40")
abline(v = 0, lty = 3, col = "grey60")

## ---- Label each point right above it, but only if that label doesn't
## overlap another label's box (skip labeling ones that would collide) ----
lbl_cex  <- 0.7
lbl_txt  <- substr(lbl$name, 1, 30)
gap_y    <- 0.035 * diff(range(dat$y, na.rm = TRUE))   # small gap above the point

w <- strwidth(lbl_txt,  cex = lbl_cex, font = 3)
h <- strheight(lbl_txt, cex = lbl_cex, font = 3) * 1.3  # a little extra padding

x0 <- lbl$log2FC - w / 2; x1 <- lbl$log2FC + w / 2
y0 <- lbl$y + gap_y;      y1 <- y0 + h

n <- nrow(lbl)
overlaps <- matrix(FALSE, n, n)
for (i in seq_len(n - 1)) {
  for (j in (i + 1):n) {
    if (x0[i] < x1[j] && x1[i] > x0[j] && y0[i] < y1[j] && y1[i] > y0[j]) {
      overlaps[i, j] <- TRUE; overlaps[j, i] <- TRUE
    }
  }
}
is_crowded <- apply(overlaps, 1, any)
cat(sprintf("Labeling %d of %d fold-change compounds (skipping %d that would overlap)\n",
            sum(!is_crowded), n, sum(is_crowded)))

lbl_clean <- lbl[!is_crowded, ]
text(lbl_clean$log2FC, lbl_clean$y, labels = substr(lbl_clean$name, 1, 30),
     cex = lbl_cex, pos = 3, offset = 0.35, xpd = TRUE, font = 3)

legend_present <- names(col_map) %in% unique(dat$status)
legend("top", legend = names(col_map)[legend_present], col = "grey30",
       pt.bg = col_map[legend_present], pch = 21, pt.cex = 1.3, cex = 0.85,
       bty = "n", horiz = TRUE)

dev.off()

## ---- 7. Save the annotated table ----
write.csv(dat[order(dat$log2FC), ],
          "/mnt/user-data/outputs/matched_compounds_table_v2.csv", row.names = FALSE)

cat("Done. Plot saved to", outfile, "\n")
